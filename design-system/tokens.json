{
  "color-fg": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.0667, 0.0941, 0.1529], "hex": "#111827"}, "$description": "Primary text"},
  "color-bg": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff"}, "$description": "Page background"},
  "color-primary": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.1451, 0.3882, 0.9216], "hex": "#2563eb"}, "$description": "Brand and primary action"},
  "color-primary-fg": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff"}, "$description": "Text on primary and danger fills"},
  "color-border": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.8196, 0.8353, 0.8588], "hex": "#d1d5db"}, "$description": "Default borders"},
  "color-muted": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.2941, 0.3333, 0.3882], "hex": "#4b5563"}, "$description": "Secondary text"},
  "color-surface": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.9529, 0.9569, 0.9647], "hex": "#f3f4f6"}, "$description": "Subtle surface fill"},
  "color-danger": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.7255, 0.1098, 0.1098], "hex": "#b91c1c"}, "$description": "Danger and error"},
  "color-danger-bg": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.9961, 0.8863, 0.8863], "hex": "#fee2e2"}, "$description": "Danger tint"},
  "color-success": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.0824, 0.502, 0.2392], "hex": "#15803d"}, "$description": "Success"},
  "color-success-bg": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.8627, 0.9882, 0.9059], "hex": "#dcfce7"}, "$description": "Success tint"},
  "color-warning": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.5725, 0.251, 0.0549], "hex": "#92400e"}, "$description": "Warning"},
  "color-warning-bg": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.9961, 0.9529, 0.7804], "hex": "#fef3c7"}, "$description": "Warning tint"},
  "color-info": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.1137, 0.3059, 0.8471], "hex": "#1d4ed8"}, "$description": "Info"},
  "color-info-bg": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.8588, 0.9176, 0.9961], "hex": "#dbeafe"}, "$description": "Info tint"},

  "space-1": {"$type": "dimension", "$value": {"value": 4, "unit": "px"}, "$description": "Spacing step 1"},
  "space-2": {"$type": "dimension", "$value": {"value": 8, "unit": "px"}, "$description": "Spacing step 2"},
  "space-3": {"$type": "dimension", "$value": {"value": 16, "unit": "px"}, "$description": "Spacing step 3"},
  "space-4": {"$type": "dimension", "$value": {"value": 24, "unit": "px"}, "$description": "Spacing step 4"},
  "space-5": {"$type": "dimension", "$value": {"value": 32, "unit": "px"}, "$description": "Spacing step 5"},
  "radius-sm": {"$type": "dimension", "$value": {"value": 4, "unit": "px"}, "$description": "Small radius"},
  "radius-md": {"$type": "dimension", "$value": {"value": 8, "unit": "px"}, "$description": "Medium radius"},
  "radius-lg": {"$type": "dimension", "$value": {"value": 12, "unit": "px"}, "$description": "Large radius"},
  "radius-full": {"$type": "dimension", "$value": {"value": 9999, "unit": "px"}, "$description": "Pill and circle"},
  "font-size-sm": {"$type": "dimension", "$value": {"value": 14, "unit": "px"}, "$description": "Small text"},
  "font-size-md": {"$type": "dimension", "$value": {"value": 16, "unit": "px"}, "$description": "Body text"},
  "font-size-lg": {"$type": "dimension", "$value": {"value": 20, "unit": "px"}, "$description": "Large text and headings"},
  "font-size-xl": {"$type": "dimension", "$value": {"value": 30, "unit": "px"}, "$description": "Page title"},
  "size-control-sm": {"$type": "dimension", "$value": {"value": 32, "unit": "px"}, "$description": "Small control height"},
  "size-control-md": {"$type": "dimension", "$value": {"value": 40, "unit": "px"}, "$description": "Default control height"},
  "size-control-lg": {"$type": "dimension", "$value": {"value": 48, "unit": "px"}, "$description": "Large control height"},
  "size-icon": {"$type": "dimension", "$value": {"value": 16, "unit": "px"}, "$description": "Checkbox, radio and icon size"},
  "size-switch-width": {"$type": "dimension", "$value": {"value": 40, "unit": "px"}, "$description": "Switch track width"},
  "size-spinner": {"$type": "dimension", "$value": {"value": 24, "unit": "px"}, "$description": "Spinner size"},
  "size-drawer": {"$type": "dimension", "$value": {"value": 360, "unit": "px"}, "$description": "Drawer width"},
  "size-modal": {"$type": "dimension", "$value": {"value": 480, "unit": "px"}, "$description": "Modal max width"},
  "size-container": {"$type": "dimension", "$value": {"value": 960, "unit": "px"}, "$description": "Page container max width"},
  "size-popup": {"$type": "dimension", "$value": {"value": 200, "unit": "px"}, "$description": "Dropdown and nav panel min width"},
  "border-width": {"$type": "dimension", "$value": {"value": 1, "unit": "px"}, "$description": "Border width"},
  "focus-ring-width": {"$type": "dimension", "$value": {"value": 2, "unit": "px"}, "$description": "Focus ring width"},

  "font-sans": {"$type": "fontFamily", "$value": "system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif", "$description": "Sans-serif stack"},
  "font-weight-regular": {"$type": "fontWeight", "$value": 400, "$description": "Regular"},
  "font-weight-medium": {"$type": "fontWeight", "$value": 500, "$description": "Medium"},
  "font-weight-bold": {"$type": "fontWeight", "$value": 700, "$description": "Bold"},
  "line-height-body": {"$type": "number", "$value": 1.5, "$description": "Body line height"},
  "opacity-disabled": {"$type": "number", "$value": 0.5, "$description": "Disabled opacity"},
  "opacity-backdrop": {"$type": "number", "$value": 0.5, "$description": "Backdrop opacity"},
  "z-popup": {"$type": "number", "$value": 50, "$description": "Popup stacking"},
  "z-overlay": {"$type": "number", "$value": 100, "$description": "Overlay stacking"},

  "button-primary-background": {"$type": "color", "$value": "{color-primary}", "$description": "Primary button fill"},
  "button-primary-color": {"$type": "color", "$value": "{color-primary-fg}", "$description": "Primary button text"},
  "button-secondary-background": {"$type": "color", "$value": "{color-surface}", "$description": "Secondary button fill"},
  "button-secondary-color": {"$type": "color", "$value": "{color-fg}", "$description": "Secondary button text"},
  "button-danger-background": {"$type": "color", "$value": "{color-danger}", "$description": "Danger button fill"},
  "button-danger-color": {"$type": "color", "$value": "{color-primary-fg}", "$description": "Danger button text"},
  "button-default-radius": {"$type": "dimension", "$value": "{radius-md}", "$description": "Button radius"},
  "card-default-background": {"$type": "color", "$value": "{color-bg}", "$description": "Card fill"},
  "card-default-border": {"$type": "color", "$value": "{color-border}", "$description": "Card border"},
  "card-default-radius": {"$type": "dimension", "$value": "{radius-lg}", "$description": "Card radius"},
  "card-default-padding": {"$type": "dimension", "$value": "{space-3}", "$description": "Card padding"}
}
